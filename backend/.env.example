# Make .env file from this template and fill in the real values.
# .env is ignored by git, so your keys stay private.
PORT=3000
# Optional: web origins allowed to call the API (comma-separated). Defaults to the Expo web app.
# CORS_ORIGINS=http://localhost:8081
SUPABASE_URL=https://your-supabase-reference.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres