# Copy this file to .env.local and fill in the real values.
# Get them from the "Env Variables" document in the team's Google Drive
# (or, for a local Supabase, from `npx supabase status -o env`).
# .env.local is ignored by git, so your keys stay private. Never commit it.
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-reference.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key