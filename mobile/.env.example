# Copy this file to .env.local and fill in the real values.
# .env.local is ignored by git, so your keys stay private.
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-reference.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# Optional: backend API address. Defaults to http://localhost:3000, which works on web.
# On a phone, use your computer's network address instead, e.g. http://192.168.1.20:3000
# EXPO_PUBLIC_API_URL=http://localhost:3000
